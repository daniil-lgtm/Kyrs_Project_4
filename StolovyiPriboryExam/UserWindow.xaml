<Window x:Class="Library_project.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека"
        Height="560"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.png"
        Background="#F4F6F9">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#E1E5EA"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="/icon.png"
                       Width="50"
                       Height="50"
                       VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Система управления библиотекой"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentUser.Name}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="10 0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0 10 0 10"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#E1E5EA"
                BorderThickness="1">

            <Grid VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                     Height="32"
                     Padding="8"
                     FontSize="12"
                     x:Name="SearchFilterTextBox"
                     KeyUp="SearchFilterTextBox_KeyUp"
                     VerticalContentAlignment="Center"
                     Foreground="Gray"
                     Text="Поиск книги"
                     GotFocus="SearchFilterTextBox_GotFocus"
                     LostFocus="SearchFilterTextBox_LostFocus"/>

                <ComboBox Grid.Column="1"
                          Margin="10 0"
                          Height="32"
                          Padding="6"
                          FontSize="14"
                          Name="SortTypeComboBox"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SortTypeComboBox_SelectionChanged"
                          ItemsSource="{Binding SortList}"/>

                <ComboBox Grid.Column="2"
                          Height="32"
                          Padding="6"
                          FontSize="14"
                          x:Name="CategoryFilter"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="CategoryFilter_SelectionChanged"
                          ItemsSource="{Binding CategoryList}"/>

                <Button Grid.Column="4"
                        x:Name="AddBookButton"
                        Content="Добавить книгу"
                        Height="34"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#2D7DFF"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="{Binding IsAdmin}"
                        Click="AddBookButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="5"
                BorderBrush="#E1E5EA"
                BorderThickness="1">

            <DataGrid x:Name="BooksGrid"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="BooksGrid_MouseDoubleClick"
                      ItemsSource="{Binding BookList}"
                      IsReadOnly="True"
                      FontSize="14"
                      RowHeight="34"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8FAFD"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Background" Value="#F0F3F7"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Автор"
                                        Binding="{Binding Avtor}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Год издания"
                                        Binding="{Binding YearBook, StringFormat=d}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Страниц"
                                        Binding="{Binding QuantityPages}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Количество"
                                        Binding="{Binding Quantity}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Категория"
                                        Binding="{Binding CategoryNavigation.Title}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>
</Window>