<Window x:Class="Library_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="460"
        Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        Icon="/icon.png">

    <Grid>

        <Border
            Background="White"
            CornerRadius="8"
            Padding="30"
            Margin="20"
            BorderBrush="#E1E5EA"
            BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0 0 0 20">

                    <Image
                        Source="/icon.png"
                        Width="60"
                        Height="60"
                        Margin="0 0 0 10"/>

                    <TextBlock
                        Text="Вход в систему"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0 10">

                    <TextBlock
                        Text="Логин"
                        FontWeight="SemiBold"
                        Margin="0 0 0 5"/>

                    <TextBox
                        x:Name="LoginBox"
                        Height="34"
                        Padding="8"
                        FontSize="12"
                        TextChanged="LoginBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0 10">

                    <TextBlock
                        Text="Пароль"
                        FontWeight="SemiBold"
                        Margin="0 0 0 5"/>

                    <PasswordBox
                        x:Name="PasswordBox"
                        Height="34"
                        Padding="8"
                        FontSize="12"/>
                </StackPanel>

                <Button
                    Grid.Row="3"
                    Content="Войти"
                    Height="40"
                    Margin="0 15 0 0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Background="#2D7DFF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Login_Button_Click"/>

                <TextBlock
                    x:Name="ErrorLabel"
                    Grid.Row="4"
                    Foreground="#D32F2F"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    Margin="0 12 0 0"
                    TextWrapping="Wrap"/>

            </Grid>

        </Border>

    </Grid>
</Window>