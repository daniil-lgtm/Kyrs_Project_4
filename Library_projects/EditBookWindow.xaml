<Window x:Class="Library_project.EditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library_project"
        mc:Ignorable="d"
        Title="Книга"
        Height="520"
        Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" Icon="/icon.png">

    <Grid Margin="15">

        <Border
            Background="White"
            CornerRadius="8"
            Padding="20"
            BorderBrush="#E1E5EA"
            BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Text="{Binding WindowTitle}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0 0 0 20"/>

                <Grid Grid.Row="1" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Название"
                        VerticalAlignment="Center"/>

                    <TextBox
                        Grid.Column="1"
                        Height="32"
                        Padding="6"
                        FontSize="14"
                        Text="{Binding CurrentBook.Name}"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Автор"
                        VerticalAlignment="Center"/>

                    <TextBox
                        Grid.Column="1"
                        Height="32"
                        Padding="6"
                        FontSize="14"
                        Text="{Binding CurrentBook.Avtor}"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Год издания"
                        VerticalAlignment="Center"/>

                    <DatePicker
                        Grid.Column="1"
                        Height="32"
                        SelectedDate="{Binding CurrentBook.YearBook}"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Страницы"
                        VerticalAlignment="Center"/>

                    <TextBox
                        Grid.Column="1"
                        Height="32"
                        Padding="6"
                        FontSize="14"
                        Text="{Binding CurrentBook.QuantityPages}"/>
                </Grid>

                <Grid Grid.Row="5" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Количество"
                        VerticalAlignment="Center"/>

                    <TextBox
                        Grid.Column="1"
                        Height="32"
                        Padding="6"
                        FontSize="14"
                        Text="{Binding CurrentBook.Quantity}"/>
                </Grid>

                <Grid Grid.Row="6" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Категория"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Column="1"
                        Height="32"
                        ItemsSource="{Binding CategoryList, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValuePath="Id"
                        DisplayMemberPath="Title"
                        SelectedValue="{Binding CurrentBook.Category}"/>
                </Grid>

                <Grid Grid.Row="7" Margin="0 5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Издательство"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Row="8"
                        Grid.Column="1"
                        Height="32"
                        ItemsSource="{Binding ManufacturerList, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValuePath="Id"
                        DisplayMemberPath="Title"
                        SelectedValue="{Binding CurrentBook.Manufacturer}"/>
                </Grid>

                <StackPanel
                    Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 20 0 0">

                    <Button
                        Content="Сохранить"
                        Width="100"
                        Height="34"
                        Margin="5"
                        FontWeight="SemiBold"
                        Background="#2D7DFF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SaveButton_Click"/>

                    <Button
                        Content="Отмена"
                        Width="100"
                        Height="34"
                        Margin="5"
                        FontWeight="SemiBold"
                        Background="LightYellow"
                        Click="CancelButton_Click"/>
                    <Button
                        Content="Удалить"
                        Width="100"
                        Height="34"
                        Margin="5"
                        FontWeight="SemiBold"
                        Background="#FF4D4F"
                        Foreground="White"
                        BorderThickness="0"
                        Click="DeleteButton_Click"/>
                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</Window>